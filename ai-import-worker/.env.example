# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=ishua:task:stream
REDIS_GROUP=ishua-ai-workers
REDIS_CONSUMER=worker_node_1

# MinerU
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 系统提示词文件（相对 ai-import-worker 目录或绝对路径）；留空则用 prompts/ai-import-system.txt
LLM_SYSTEM_PROMPT_PATH=

# Debug：开启后每个任务在 DEBUG_TEMP_DIR 下创建独立目录，保存 MinerU zip、markdown、LLM user prompt 与原始返回
DEBUG_MODE=false
DEBUG_TEMP_DIR=./temp

# 跳过 LLM：仅跑 MinerU 解析，结果为空题目列表（调试 MinerU 时可用，无需配置 LLM_API_KEY）
SKIP_LLM=false

# ============================================
# AI 解答独立流程（answer_worker）
# 启动：python -m answer_worker
# ============================================
ANSWER_REDIS_STREAM=ishua:answer:stream
ANSWER_REDIS_GROUP=ishua-answer-workers
ANSWER_REDIS_CONSUMER=answer_worker_1

# 分片大小（每片题目数）与投票轮数；N 题 → 调用次数 ≈ ceil(N/SHARD) * VOTE_ROUNDS
ANSWER_SHARD_SIZE=10
ANSWER_VOTE_ROUNDS=3
# 投票时采样温度，引入多样性
ANSWER_TEMPERATURE=0.4
# 解答专用模型；留空则复用 LLM_MODEL
ANSWER_LLM_MODEL=
# shard 并发数
ANSWER_MAX_CONCURRENCY=4
# 是否跳过简答题（目前暂时不支持 AI 解答）
ANSWER_SKIP_SHORT_ANSWER=true
# 解答 LLM 单次调用超时
ANSWER_LLM_TIMEOUT_SECONDS=120
# 解答专用系统提示词；留空则用 prompts/ai-answer-system.txt
ANSWER_SYSTEM_PROMPT_PATH=
